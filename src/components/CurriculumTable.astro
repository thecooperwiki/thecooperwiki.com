---
import { getEntry } from "astro:content"

type Course = string | { title: string, credits: number }

interface Props {
    courses: Course[]
}

const { courses } = Astro.props

const data = await Promise.all(
    courses.map(async (course) => {
        if (typeof course === "object") return course // used for electives

        const path = `academics/courses/${course}`
        const entry = await getEntry("docs", path)

        if (entry) return {
            path: `/${path}`,
            code: entry.data.sidebar?.label || "N/A",
            title: entry.data.title || "N/A",
            credits: entry.data.credits ?? "N/A",
        }

        // course has no page
        return {
            path,
            code: "",
            title: course,
            credits: 0,
        }
    })
)

let totalCredits = 0

for (const course of data) {
    totalCredits += course.credits
}
--- 

<table>
    <thead>
        <tr>
            <th>Course</th>
            <th>Name</th>
            <th>Credits</th>
        </tr>
    </thead>
    <tbody>
        {
            data.map((course) => (
                <tr>
                    <td>{course.code ? <a href={course.path}>{course.code}</a> : ""}</td>
                    <td>{course.title}</td>
                    <td>{course.credits}</td>
                </tr>
            ))
        }

        <tr>
            <td></td>
            <td><strong>Total Credits</strong></td>
            <td><strong>{totalCredits}</strong></td>
        </tr>
    </tbody>
</table>

